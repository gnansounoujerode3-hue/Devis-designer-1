{
  "name": "devis-designer",
  "private": true,
  "version": "1.3.3",
  "description": "Devis Designer — Générateur de devis et factures professionnels (application web)",
  "author": "Votre Nom",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && npx vercel --prod",
    "deploy:cf": "vite build && npx wrangler deploy",
    "design:pack": "esbuild scripts/design-pack.ts --bundle --platform=node --format=cjs --external:esbuild --outfile=node_modules/.dd/design-pack.cjs --log-level=warning && node node_modules/.dd/design-pack.cjs",
    "test:ui": "node tests/run.mjs tests/design_test.tsx tests/landing_test.tsx tests/emitter_test.tsx tests/deploy_test.tsx tests/workerbase_test.tsx tests/pulse_test.tsx",
    "test": "npm run test:ui"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "jspdf": "^4.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "svg2pdf.js": "^2.7.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.27.7",
    "playwright-core": "^1.62.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
